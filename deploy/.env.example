# 复制为 .env 使用；真实秘钥禁止提交入库

# 大模型（OpenAI 兼容协议，必须支持 Function Calling / Tool Use）
# 留空则自动使用确定性规则引擎，系统仍可完整生成行程
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=20

# MySQL 8.0（docker compose 启动时自动建库并执行 deploy/mysql/init）
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PASSWORD=travel_dev
DATABASE_URL=mysql+pymysql://travel:travel_dev@mysql:3306/travel_planning?charset=utf8mb4

# 外部工具：单工具超时与故障注入演练（TOOL_OFFLINE=true 时全部降级）
TOOL_TIMEOUT_MS=5000
TOOL_OFFLINE=false

# 应用
APP_ENV=dev
CORS_ORIGINS=*

# 文件上传与下载
# 单文件分片大小（默认 5MB）、整体上限（默认 2GB）
CHUNK_SIZE=5242880
MAX_UPLOAD_SIZE=2147483648
# 批量小文件：单批数量与单文件大小上限
MAX_BATCH_FILES=50
MAX_BATCH_FILE_SIZE=52428800
# true 时后端返回 X-Accel-Redirect，由前端 Nginx 直接发送（需挂载 file-data 卷）
# docker compose 已强制设为 true；本地直连 uvicorn 演示时保持 false
NGINX_ACCEL=false
