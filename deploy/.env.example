# 复制为 .env 使用；真实秘钥禁止提交入库

# 大模型（OpenAI 兼容协议，必须支持 Function Calling / Tool Use）
# 留空则自动使用确定性规则引擎，系统仍可完整生成行程
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=20

# MySQL 8.0（docker compose 启动时自动建库并执行 deploy/mysql/init）
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PASSWORD=travel_dev
DATABASE_URL=mysql+pymysql://travel:travel_dev@mysql:3306/travel_planning?charset=utf8mb4

# 外部工具：单工具超时与故障注入演练（TOOL_OFFLINE=true 时全部降级）
TOOL_TIMEOUT_MS=5000
TOOL_OFFLINE=false

# 应用
APP_ENV=dev
CORS_ORIGINS=*

# Redis：会话、验证码、登录限流、权限缓存、字典缓存
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
AUTH_TOKEN_TTL_S=7200
AUTHZ_CACHE_TTL_S=300

# 登录安全
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_S=900
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60
CAPTCHA_DEBUG=false

# 初始化 RBAC 与演示账号（首次启动自动创建）
SEED_RBAC=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_DEMO_USERNAME=traveler
SEED_DEMO_PASSWORD=Traveler@123456
